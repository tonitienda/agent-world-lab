{
  "name": "agent-world-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "tsx src/mcp/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "integration": "tsx scripts/integration.ts",
    "record": "tsx scripts/record-session.ts",
    "bot-smoke": "tsx scripts/bot-actions-smoke.ts",
    "capture-smoke": "tsx scripts/capture-smoke.ts",
    "episode:plan": "tsx scripts/episode-plan.ts",
    "pilot-session": "tsx scripts/pilot-agent-session.ts",
    "world:reset": "tsx scripts/reset-minecraft-world.ts",
    "episode:render-simple": "tsx scripts/episode-render-simple.ts",
    "episode:validate": "node production/tools/episode.mjs",
    "episode:render": "node production/tools/episode.mjs --render",
    "episode:check-render": "node production/tools/check-render.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.0",
    "mineflayer": "^4.32.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}