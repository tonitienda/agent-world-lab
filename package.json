{
  "name": "agent-world-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "tsx src/mcp/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check": "tsc --noEmit && tsc -p packages/detonarium && tsc -p packages/chess && tsc -p packages/openttd && tsc -p packages/freeciv && tsc -p packages/hedgewars",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs packages/detonarium/test/*.test.ts packages/chess/test/*.test.ts packages/openttd/test/*.test.ts packages/freeciv/test/*.test.ts packages/hedgewars/test/*.test.ts",
    "integration": "tsx scripts/integration.ts",
    "record": "tsx scripts/record-session.ts",
    "bot-smoke": "tsx scripts/bot-actions-smoke.ts",
    "capture-smoke": "tsx scripts/capture-smoke.ts",
    "episode:plan": "tsx scripts/episode-plan.ts",
    "pilot-session": "tsx scripts/pilot-agent-session.ts",
    "world:reset": "tsx scripts/reset-minecraft-world.ts",
    "episode:render-simple": "tsx scripts/episode-render-simple.ts",
    "episode:validate": "node production/tools/episode.mjs",
    "episode:render": "node production/tools/episode.mjs --render",
    "episode:check-render": "node production/tools/check-render.mjs",
    "world:preflight": "tsx scripts/world-preflight.ts",
    "session:control": "tsx scripts/session-control.ts",
    "integration:survival": "tsx scripts/survival-integration.ts",
    "integration:recorder": "node packages/minecraft-recorder/integration.cjs",
    "scenario:ravine": "tsx scripts/setup-ravine.ts",
    "integration:ravine": "tsx scripts/ravine-integration.ts",
    "integration:orchestration": "tsx scripts/emergence-integration.ts",
    "integration:pipeline": "tsx scripts/emergence-integration.ts --guided",
    "chess:play": "tsx scripts/chess-session.ts",
    "chess:youtube": "node --import tsx scripts/chess-youtube.ts",
    "chess:record": "tsx packages/chess/examples/record.ts",
    "chess:mcp": "tsx src/mcp/chess.ts",
    "detonarium:mcp": "tsx src/mcp/detonarium.ts",
    "detonarium:play": "tsx scripts/detonarium-session.ts",
    "detonarium:record": "tsx scripts/detonarium-record.ts",
    "openttd:setup": "node --import tsx scripts/openttd-setup.ts",
    "openttd:spike": "node --import tsx scripts/openttd-spike.ts",
    "openttd:record": "node --import tsx scripts/openttd-record.ts",
    "openttd:play": "node --import tsx scripts/openttd-session.ts",
    "openttd:prepare-freight": "node --import tsx scripts/openttd-prepare-freight.ts",
    "openttd:mcp": "node --import tsx src/mcp/openttd.ts",
    "openttd:episode": "node production/episode-007/prepare.mjs",
    "episode:007": "node production/episode-007/run.mjs",
    "openttd:test": "node --import tsx --test packages/openttd/test/*.test.ts",
    "freeciv:build": "docker build -t agent-world/freeciv:3.1.4-json packages/freeciv",
    "freeciv:spike": "node --import tsx scripts/freeciv-spike.ts",
    "freeciv:test": "node --import tsx --test packages/freeciv/test/*.test.ts",
    "hedgewars:build": "docker build -t agent-world/hedgewars:spike packages/hedgewars",
    "hedgewars:spike": "node --import tsx scripts/hedgewars-spike.ts",
    "hedgewars:session": "node --import tsx scripts/hedgewars-session.ts",
    "hedgewars:mcp": "node --import tsx src/mcp/hedgewars.ts",
    "hedgewars:test": "node --import tsx --test packages/hedgewars/test/*.test.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "@modelcontextprotocol/sdk": "^1.19.0",
    "chess.js": "^1.4.0",
    "mineflayer": "^4.32.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-nbt": "^2.8.0",
    "stockfish": "^17.1.0",
    "vec3": "^0.1.10",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
