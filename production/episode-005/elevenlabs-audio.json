      "audio": "3_Chapter_1.wav",
      "speaker": "agent",
      "name": "Larry",
      "voiceId": "pgXLagTlUQcy1LT68JCe",
      "text": "With black's light bishop stuck behind e6, closing the center with e5 gives me space and a good kingside attacking setup.",
      "modelId": "eleven_v4",
      "outputFormat": "mp3_44100_128",
      "fingerprint": "f5a70aeee5030e9173898c989a7b2c101a4f94f699cab8ed7193bccfc339e2cd",
